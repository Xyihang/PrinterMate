<Window x:Class="PrinterMate.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrinterMate"
        Width="660" Height="460"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBox x:Name="BodyText" Grid.Row="1"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Background="#FFF8F8F8"
                 BorderBrush="#FFCCCCCC"
                 Padding="8"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                 FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="96" Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton" Content="确认" IsDefault="True" MinWidth="96" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
