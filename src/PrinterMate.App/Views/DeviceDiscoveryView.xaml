<UserControl x:Class="PrinterMate.App.Views.DeviceDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 与「驱动管理」页同一条约定:全页只留一个滚动宿主,内层列表不自己滚动。 -->
        <Style x:Key="EmbeddedGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <StackPanel>

            <!-- ── 新手教程 ── -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="新手必读:三步连上打印机"/>
            <Border Style="{StaticResource Card}" Background="#FFF6F9FF" BorderBrush="#FF2E6FB7" BorderThickness="1">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontWeight="Bold"
                               Text="这个工具帮你做三件事:找到打印机、把驱动装好、打一张测试页。你不需要去网上找驱动。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF2E6FB7"
                               Text="最常见的情况:打印机用 USB 线插在这台电脑上。"/>

                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="第 1 步  "/>
                        <Run Text="确认打印机已开机,USB 线两端都插好(换一个 USB 口有时也管用)。"/>
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="第 2 步  "/>
                        <Run Text="点下面的「扫描 USB 打印机」,列表里就会出现你的打印机。"/>
                    </TextBlock>
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="第 3 步  "/>
                        <Run Text="点那台打印机后面的「一键连接」。程序会自己判断要不要装驱动;要装的时候会弹管理员确认框,点「是」就行。"/>
                    </TextBlock>

                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF1B7F3B" FontWeight="Bold"
                               Text="连上之后,去「打印与测试页」页点「打印系统测试页」——能打出纸,就说明整条链路都通了。"/>

                    <TextBlock Margin="0,10,0,0" FontWeight="Bold" Text="列表里「状态」这一列是什么意思:"/>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="· 已就绪 —— 已经能用,直接打印就行。"/>
                    <TextBlock TextWrapping="Wrap" Text="· 需要创建队列 —— 设备插着,但系统里还没建立这台打印机,点「一键连接」即可。"/>
                    <TextBlock TextWrapping="Wrap" Text="· 需更换驱动 —— 现在用的是通用占位驱动,功能不全,建议换成厂商驱动。"/>
                    <TextBlock TextWrapping="Wrap" Text="· 端口缺失 —— 系统还没认出它,请重新插拔 USB 线,或换一个 USB 口再点扫描。"/>

                    <Expander Margin="0,10,0,0" Header="遇到问题怎么办?(点开看)">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:点「一键连接」后弹出管理员权限确认框?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,10"
                                       Text="答:装驱动必须要有管理员权限,这是 Windows 的要求,点「是」即可。主程序平时不会常驻管理员权限,只有安装那一下会申请。"/>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:点了「扫描 USB 打印机」,但列表是空的?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,10"
                                       Text="答:按顺序试:① 确认打印机开机且不在报错;② 重新插拔 USB 线;③ 换一个 USB 口(优先插机箱后面的口);④ 换一根 USB 线;⑤ 重新点扫描。"/>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:提示「未找到匹配的驱动」怎么办?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,10"
                                       Text="答:去「驱动管理」页,用「在线补齐」从微软官方源检索,或先自己从厂商官网下载驱动包,再用「选择本地驱动包…」交给程序处理。"/>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:断网能用吗?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,10"
                                       Text="答:能。只要该品牌的驱动包已经收进本机驱动库(在「驱动管理」页能看到「已入库」),安装过程完全不需要联网。库里没有的品牌才需要联网获取。"/>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:会不会装到病毒或捆绑软件?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,10"
                                       Text="答:程序只从白名单官方源(微软官方更新服务 + 厂商官网域名)获取驱动,并且强制校验 HTTPS 证书、SHA256 哈希和数字签名,任何一项不通过都会拒绝安装并记入日志。第三方驱动站不在白名单内,程序不会自动从那里下载任何东西。"/>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="问:我的打印机本来就能打印,只想打一张测试页?"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,2,0,0"
                                       Text="答:不用扫描也不用装驱动,直接去「打印与测试页」页选好打印机,点「打印系统测试页」即可。"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="设备发现与连接(USB 直连优先)"/>

            <WrapPanel Margin="0,0,0,6">
                <Button Content="扫描 USB 打印机" Command="{Binding ScanUsbCommand}"/>
                <Button Content="扫描局域网" Command="{Binding ScanNetworkCommand}"/>
                <Button Content="清除人工驱动" Command="{Binding ClearManualDriverCommand}"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualDriverText}"/>

            <!-- ── USB ── -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="USB 直连打印机"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding UsbSummary}"/>

            <DataGrid Style="{StaticResource EmbeddedGrid}"
                      ItemsSource="{Binding UsbDevices}"
                      SelectedItem="{Binding SelectedUsbDevice}"
                      Margin="0,0,0,6"
                      Visibility="{Binding HasUsbDevices, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备名" Binding="{Binding DeviceName}" Width="2*"/>
                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="2*"/>
                    <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="90"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="120"/>
                    <DataGridTextColumn Header="驱动层" Binding="{Binding LayerText}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="一键连接"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding CanConnect}"
                                        MinWidth="86"
                                        Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource Hint}"
                       Text="尚未检测到 USB 打印机。请确认打印机已开机并通过 USB 线连接本机,然后点击「扫描 USB 打印机」。"
                       Visibility="{Binding HasNoUsbDevices, Converter={StaticResource BoolToVisibility}}"/>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasUsbDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="驱动决策详情(选中 USB 设备)"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.DeviceName, TargetNullValue=请在列表中选中一台设备}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.DecisionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.SuggestionText}" TextWrapping="Wrap" Foreground="#FF8A5A00" Margin="0,2,0,0"/>
                    <TextBlock Text="候选驱动:" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.CandidateText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- ── 局域网 ── -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="局域网打印机与手动添加"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding NetworkSummary}"/>

            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="地址(IP / 主机名):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="200" Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" Margin="0,0,8,0"/>
                <TextBlock Text="协议:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="110" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" Margin="0,0,8,0"/>
                <Button Content="手动添加" Command="{Binding AddManualCommand}"/>
            </WrapPanel>

            <DataGrid Style="{StaticResource EmbeddedGrid}"
                      ItemsSource="{Binding NetworkDevices}"
                      SelectedItem="{Binding SelectedNetworkDevice}"
                      Margin="0,0,0,6"
                      Visibility="{Binding HasNetworkDevices, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="2*"/>
                    <DataGridTextColumn Header="连接方式" Binding="{Binding ConnectionText}" Width="110"/>
                    <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="140"/>
                    <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="120"/>
                    <DataGridTextColumn Header="驱动层" Binding="{Binding LayerText}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="连接" Command="{Binding ConnectCommand}" MinWidth="70" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource Hint}"
                       Text="尚未发现局域网打印机。可点击「扫描局域网」自动发现,或在上面输入 IP/主机名手动添加。"
                       Visibility="{Binding HasNoNetworkDevices, Converter={StaticResource BoolToVisibility}}"/>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasNetworkDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="驱动决策详情(选中局域网设备)"/>
                    <TextBlock Text="{Binding SelectedNetworkDevice.Name, TargetNullValue=请在列表中选中一台设备}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedNetworkDevice.SuggestionText}" TextWrapping="Wrap" Foreground="#FF8A5A00" Margin="0,2,0,0"/>
                    <TextBlock Text="候选驱动:" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SelectedNetworkDevice.CandidateText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- ── 安装步骤 ── -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="最近一次安装/连接的执行明细"/>
            <DataGrid ItemsSource="{Binding Steps}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      MaxHeight="240"
                      Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="步骤" Binding="{Binding StepText}" Width="110"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                    <DataGridTextColumn Header="命令" Binding="{Binding CommandText}" Width="3*"/>
                    <DataGridTextColumn Header="返回码" Binding="{Binding ExitCodeText}" Width="70"/>
                    <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="尚未执行安装。连接设备后,这里会实时显示每一步的命令与返回码。"
                       Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVisibility}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
