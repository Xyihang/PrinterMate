<UserControl x:Class="PrinterMate.App.Views.DeviceDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 与「驱动管理」页同一条约定:全页只留一个滚动宿主,内层列表不自己滚动。
             ⚠ 性能红线:下面三个 Setter(禁用内层滚动 ×2 + 关闭虚拟化)不得删除。 -->
        <Style x:Key="EmbeddedGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <StackPanel>

            <!-- ══ 主操作区(USB 直连 = 主场景,排在最上,首屏必见)══ -->

            <TextBlock Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,8"
                       Text="USB 直连打印机"/>

            <WrapPanel Margin="0,0,0,8">
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="扫描 USB 打印机"
                        Command="{Binding ScanUsbCommand}"/>
                <Button Content="扫描局域网" Command="{Binding ScanNetworkCommand}"/>
                <Button Content="清除人工驱动" Command="{Binding ClearManualDriverCommand}"/>
            </WrapPanel>

            <!-- 教程收敛为一行摘要 + 可展开三步说明(完整教程仍在左侧「新手必读」页) -->
            <Expander IsExpanded="False">
                <Expander.Header>
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0"
                               Text="第一次用?点这里看 USB 三步连接说明;完整教程在左侧「新手必读」。"/>
                </Expander.Header>
                <Border Style="{StaticResource Card}" Background="{StaticResource Brush.InfoSurface}" BorderBrush="{StaticResource Brush.Accent}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="第 1 步  确认打印机已开机,USB 线两端都插好(换一个 USB 口有时也管用)。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="第 2 步  点上方「扫描 USB 打印机」,列表里就会出现这台打印机。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="第 3 步  点那一行后面的「一键连接」。程序会自己判断要不要装驱动;要装的时候会弹管理员确认框,点「是」就行。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="连上之后,去左侧「打印与测试页」点「打印系统测试页」——能打出纸,就说明整条链路都通了。"/>
                    </StackPanel>
                </Border>
            </Expander>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualDriverText}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding UsbSummary}"/>

            <DataGrid Style="{StaticResource EmbeddedGrid}"
                      ItemsSource="{Binding UsbDevices}"
                      SelectedItem="{Binding SelectedUsbDevice}"
                      Margin="0,0,0,6"
                      Visibility="{Binding HasUsbDevices, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备名" Binding="{Binding DeviceName}" Width="2*"/>
                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="2*"/>
                    <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="90"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="120"/>
                    <DataGridTextColumn Header="驱动层" Binding="{Binding LayerText}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="一键连接"
                                        Command="{Binding ConnectCommand}"
                                        IsEnabled="{Binding CanConnect}"
                                        MinWidth="86"
                                        Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource EmptyStateCard}"
                    Visibility="{Binding HasNoUsbDevices, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource EmptyState}"
                           Text="尚未检测到 USB 打印机。请确认打印机已开机并通过 USB 线连接本机,然后点击上方「扫描 USB 打印机」。"/>
            </Border>

            <!-- 「状态」列的四种含义:紧贴状态列,默认收起,需要时展开 -->
            <Expander IsExpanded="False">
                <Expander.Header>
                    <TextBlock Style="{StaticResource Hint}" Margin="0" Text="「状态」这一列是什么意思?点开看四种含义"/>
                </Expander.Header>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="· 已就绪 —— 已经能用,直接打印就行。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="· 需要创建队列 —— 设备插着,但系统里还没建立这台打印机,点「一键连接」即可。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="· 需要换驱动 —— 现在用的是通用占位驱动,功能不全,建议换成厂商驱动。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Text="· 端口缺失 —— 系统还没认出它,请重新插拔 USB 线,或换一个 USB 口再扫描。"/>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- 驱动决策详情:原因与建议保持可见;冗长的候选清单收起 -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasUsbDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="驱动决策详情(选中的 USB 设备)"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.DeviceName, TargetNullValue=请在列表中选中一台设备}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.DecisionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SelectedUsbDevice.SuggestionText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}"
                               Margin="0,2,0,0"/>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="候选驱动清单"/>
                        </Expander.Header>
                        <TextBlock Style="{StaticResource TextMono}" Text="{Binding SelectedUsbDevice.CandidateText}"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ 局域网(补充路径,排在 USB 之后)══ -->

            <TextBlock Style="{StaticResource SectionHeader}" Text="局域网打印机与手动添加"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding NetworkSummary}"/>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="地址(IP / 主机名):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="200"
                         Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"/>
                <TextBlock Text="协议:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="110" ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" Margin="0,0,8,0"/>
                <Button Content="手动添加" Command="{Binding AddManualCommand}"/>
            </WrapPanel>

            <DataGrid Style="{StaticResource EmbeddedGrid}"
                      ItemsSource="{Binding NetworkDevices}"
                      SelectedItem="{Binding SelectedNetworkDevice}"
                      Margin="0,0,0,6"
                      Visibility="{Binding HasNetworkDevices, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="2*"/>
                    <DataGridTextColumn Header="连接方式" Binding="{Binding ConnectionText}" Width="110"/>
                    <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="140"/>
                    <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="120"/>
                    <DataGridTextColumn Header="驱动层" Binding="{Binding LayerText}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="连接" Command="{Binding ConnectCommand}" MinWidth="70" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource EmptyStateCard}"
                    Visibility="{Binding HasNoNetworkDevices, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource EmptyState}"
                           Text="尚未发现局域网打印机。可点击「扫描局域网」自动发现,或在上面输入 IP/主机名手动添加。"/>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasNetworkDevices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="驱动决策详情(选中的局域网设备)"/>
                    <TextBlock Text="{Binding SelectedNetworkDevice.Name, TargetNullValue=请在列表中选中一台设备}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedNetworkDevice.SuggestionText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}"
                               Margin="0,2,0,0"/>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="候选驱动清单"/>
                        </Expander.Header>
                        <TextBlock Style="{StaticResource TextMono}" Text="{Binding SelectedNetworkDevice.CandidateText}"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ 执行明细(排查用,低频)══ -->
            <!-- 注意:连接过程中会实时刷新,故不折叠 —— 否则装驱动时看不到进度 -->

            <TextBlock Style="{StaticResource SectionHeader}" Text="最近一次安装/连接的执行明细"/>
            <DataGrid Style="{StaticResource EmbeddedGrid}"
                      ItemsSource="{Binding Steps}"
                      MaxHeight="240"
                      Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="步骤" Binding="{Binding StepText}" Width="110"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="3*"/>
                    <DataGridTextColumn Header="命令" Binding="{Binding CommandText}" Width="3*"/>
                    <DataGridTextColumn Header="返回码" Binding="{Binding ExitCodeText}" Width="70"/>
                    <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Style="{StaticResource EmptyStateCard}"
                    Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource EmptyState}"
                           Text="尚未执行安装。连接设备后,这里会实时显示每一步的命令与返回码。"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
