<UserControl x:Class="PrinterMate.App.Views.PrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="目标打印机"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="打印队列:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="360"
                          ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name"
                          Margin="0,0,10,0"/>
                <Button Content="刷新打印机列表" Command="{Binding RefreshPrintersCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding SelectedPrinterText}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding PrinterSummary}"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="测试页"/>
            <WrapPanel Margin="0,0,0,6">
                <Button Content="打印系统测试页" Command="{Binding PrintSystemTestPageCommand}"/>
                <Button Content="打印自绘测试页" Command="{Binding PrintCustomTestPageCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="「系统测试页」调用 Windows 自带的测试页功能,用于验证驱动与端口是否通畅;「自绘测试页」由程序用矢量绘图生成,包含色彩条、灰阶条与对齐网格,完全绕过驱动自带的图案。"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="文件打印"/>
            <WrapPanel Margin="0,0,0,6">
                <Button Content="打印本地文件" Command="{Binding PrintFileCommand}"/>
                <Button Content="投递 RAW 数据" Command="{Binding PrintRawCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding SelectedFilePath}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding DetectedKindText}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="支持类型:文本(.txt/.log/.csv/.md/.json/.xml)、图片(.png/.jpg/.bmp/.gif/.tif)、XPS(.xps/.oxps)、PDF(.pdf)、RAW(.prn/.ps/.pcl/.zpl/.bin)。PDF 会调用系统默认程序打印;RAW 会原样把字节发送到打印队列。"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
