<UserControl x:Class="PrinterMate.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        本页是"固定高度页面"布局(无整页 ScrollViewer,作业表格占满 * 行)。
        与「设备发现」页的"整页滚动 + 内层禁滚"模式不同:
        因此作业表格【不能】套 EmbeddedGrid(禁用内层滚动),否则作业列表将无法滚动。
        作业表格未设显式 Style,隐式 DataGrid 样式(Resources/DataViews.xaml)自动生效。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 顶部:打印机选择 + 刷新 + 导出 ══ -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="打印队列与状态"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="打印队列:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="330"
                          ItemsSource="{Binding Printers}"
                          SelectedItem="{Binding SelectedPrinter}"
                          DisplayMemberPath="Name"
                          Margin="0,0,10,0"/>
                <Button Content="立即刷新" Command="{Binding RefreshCommand}"/>
                <CheckBox Content="每 5 秒自动刷新"
                          IsChecked="{Binding AutoRefreshEnabled}"
                          VerticalAlignment="Center"
                          Margin="4,0,10,0"/>
                <Button Content="导出诊断报告" Command="{Binding ExportDiagnosticsCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding SelectedPrinterText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ 打印机健康状态:级别图标 + 结论 + 建议 ══ -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Top"
                          Margin="0,3,10,0"
                          Fill="{Binding HealthLevel, Converter={StaticResource StatusLevelBrush}}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Icon.Info}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthLevel}" Value="Success">
                                        <Setter Property="Data" Value="{StaticResource Icon.Check}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthLevel}" Value="Warning">
                                        <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthLevel}" Value="Error">
                                        <Setter Property="Data" Value="{StaticResource Icon.Error}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="打印机健康状态" Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding HealthText}"
                                   FontSize="{StaticResource Font.Size.Subtitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Foreground="{Binding HealthLevel, Converter={StaticResource StatusLevelBrush}}"/>
                        <TextBlock Text="{Binding HealthAdvice}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 作业列表(占满剩余高度,自身可滚动)══ -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Jobs}"
                      SelectedItem="{Binding SelectedJob}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="任务名" Binding="{Binding Document}" Width="3*"/>
                    <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="140"/>
                    <DataGridTextColumn Header="页数(已打印/总数)" Binding="{Binding PageText}" Width="140"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="140"/>
                    <DataGridTextColumn Header="提交时间" Binding="{Binding SubmittedText}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ══ 操作区:队列级 / 作业级分组,危险操作明确标注 ══ -->
            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource Hint}" Text="{Binding JobsSummary}"/>

                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="队列:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <Button Content="暂停队列" Command="{Binding PauseQueueCommand}"/>
                    <Button Content="恢复队列" Command="{Binding ResumeQueueCommand}"/>
                    <Button Content="清空队列" Command="{Binding PurgeQueueCommand}"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource TextWarning}"
                           Margin="0,0,0,6"
                           Text="注意:「清空队列」会删除该打印机上所有未完成的作业,无法撤销。"/>

                <WrapPanel>
                    <TextBlock Text="作业:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <Button Content="暂停作业" Command="{Binding PauseJobCommand}"/>
                    <Button Content="恢复作业" Command="{Binding ResumeJobCommand}"/>
                    <Button Content="取消作业" Command="{Binding CancelJobCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
