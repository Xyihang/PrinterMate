<UserControl x:Class="PrinterMate.App.Views.DriverManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="内置驱动库状态(离线可用的关键)"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding LibraryHeadline}" FontWeight="Bold"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding ManifestSource, StringFormat=清单来源:{0}}"/>
                    <TextBlock Text="{Binding Root, StringFormat=驱动库根目录:{0}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ManifestPath, StringFormat=清单文件:{0}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LibraryVersion, StringFormat=清单版本:{0}}"/>
                    <TextBlock Text="{Binding ArchitectureText, StringFormat=当前架构 / 系统:{0}}"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                               Text="{Binding UnavailableEntries, StringFormat=不可直接安装的条目数:{0}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    BorderBrush="#FFC02828"
                    BorderThickness="1"
                    Visibility="{Binding HasMissingPackages, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding MissingHeader}" FontWeight="Bold" Foreground="#FFC02828" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding MissingPackages}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="内置驱动许可(本机授权开关)"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding PolicyHint}" TextWrapping="Wrap" Foreground="#FF666666"/>
                    <TextBlock Margin="0,6,0,0" Text="{Binding PolicySummary, StringFormat=当前策略:{0}}" TextWrapping="Wrap" FontWeight="Bold"/>

                    <CheckBox Margin="0,8,0,0"
                              Content="允许全部品牌使用内置驱动(仅本机个人使用)"
                              IsChecked="{Binding AllowAllBuiltinDrivers}"/>

                    <TextBlock Margin="0,8,0,2" Text="按品牌单独设置(优先级高于上面的全局开关):"/>
                    <DataGrid ItemsSource="{Binding BrandPolicies}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="240"
                              Visibility="{Binding HasBrandPolicies, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="清单情况" Binding="{Binding SummaryText}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="允许内置驱动" Binding="{Binding IsBuiltinAllowed, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="各品牌可用性统计"/>
            <DataGrid ItemsSource="{Binding BrandSummaries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="180"/>
                    <DataGridTextColumn Header="条目统计" Binding="{Binding SummaryText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="全部内置驱动条目(按品牌分组,可展开)"/>
            <TreeView ItemsSource="{Binding BrandGroups}" MaxHeight="340">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Entries}">
                        <TextBlock Text="{Binding Header}" FontWeight="Bold" Margin="0,2"/>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding DriverName}" Width="300" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PdlText}" Width="100"/>
                                    <TextBlock Text="{Binding ArchText}" Width="110"/>
                                    <TextBlock Text="{Binding RedistributableText}" Width="80"/>
                                    <TextBlock Text="{Binding AvailableText}" Width="70"
                                               Foreground="{Binding IsAvailable, Converter={StaticResource BoolToBrush}}"/>
                                    <TextBlock Text="{Binding Reason}" Foreground="#FF666666" MaxWidth="420"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Style="{StaticResource SectionHeader}" Text="第三方驱动站检索(风险自担)"/>
            <Border Style="{StaticResource Card}" BorderBrush="#FFB45309" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding SiteHint}" TextWrapping="Wrap" Foreground="#FFB45309"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="站点:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding DriverSites}"
                                  SelectedItem="{Binding SelectedSite}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,12,0"/>
                        <TextBlock Text="打印机型号:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="220" Padding="4,3" Margin="0,0,12,0"
                                 Text="{Binding SiteModel, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="在浏览器中打开搜索页" Padding="12,4"
                                Command="{Binding OpenSiteSearchCommand}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="提示:驱动天空(drvsky)只接受 POST 检索,程序会在本机生成一个表单页并交由浏览器提交;程序自身不会向该站发起请求。"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="人工选择驱动(自动匹配失败时使用)"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="品牌:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="150" ItemsSource="{Binding Brands}" SelectedItem="{Binding BrandFilter}" Margin="0,0,10,0"/>
                <TextBlock Text="型号关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="200" Padding="4,3" Margin="0,0,10,0"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="检索候选驱动" Command="{Binding SearchCandidatesCommand}"/>
                <Button Content="刷新驱动库状态" Command="{Binding RefreshCommand}"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualSummary}"/>

            <ListBox ItemsSource="{Binding ManualCandidates}"
                     SelectedItem="{Binding SelectedManualCandidate}"
                     Height="190"
                     Margin="0,0,0,6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DriverName}" Width="300" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Brand}" Width="110"/>
                            <TextBlock Text="{Binding PdlText}" Width="100"/>
                            <TextBlock Text="{Binding SourceText}" Width="110"/>
                            <TextBlock Text="{Binding ConfidenceText, StringFormat=置信度 {0}}" Width="90"/>
                            <TextBlock Text="可用" Foreground="#FF1B7F3B"
                                       Visibility="{Binding Installable, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding BlockReason}" Foreground="#FFC02828"
                                       Visibility="{Binding Installable, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <WrapPanel Margin="0,0,0,6">
                <Button Content="设为连接时使用的驱动" Command="{Binding UseCandidateCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualSelectionText}"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="在线补齐(L2)"/>
            <Border Style="{StaticResource Card}" Background="#FFFFF7E6" BorderBrush="#FFB56A00">
                <StackPanel>
                    <TextBlock Text="状态:待实现 / 后续版本" FontWeight="Bold" Foreground="#FFB56A00"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="本版本不具备联网下载驱动的能力。当内置驱动库中没有可用条目时,程序不会访问任何网络地址,也不会静默降级。
后续版本将按白名单(Microsoft 官方源 + 厂商官方域名,可在「设置」页查看)下载驱动包,并在安装前校验 HTTPS 证书、SHA256 与数字签名。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="当前建议:请使用厂商官方安装包安装驱动,或在「设置」页确认驱动库根目录是否已放入对应品牌的驱动包与清单。"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
