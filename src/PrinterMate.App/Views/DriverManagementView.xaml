<UserControl x:Class="PrinterMate.App.Views.DriverManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!--
            性能约定:本页只有最外层 ScrollViewer 一个滚动宿主。
            内层列表一律关闭自身滚动条与其虚拟化面板 —— 它们被嵌在无限高度的父容器里,
            虚拟化本来就不会生效,只会白白多出滚动宿主与命中测试层次,造成滚动卡顿。
        -->
        <Style x:Key="EmbeddedGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
        </Style>

        <Style x:Key="EmbeddedList" TargetType="ListBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
        </Style>

        <Style x:Key="EmbeddedTree" TargetType="TreeView">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="第三方驱动站检索(风险自担)"/>
            <Border Style="{StaticResource Card}" BorderBrush="#FFB45309" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding SiteHint}" TextWrapping="Wrap" Foreground="#FFB45309"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="站点:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding DriverSites}"
                                  SelectedItem="{Binding SelectedSite}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,12,0"/>
                        <TextBlock Text="打印机型号:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="220" Padding="4,3" Margin="0,0,12,0"
                                 Text="{Binding SiteModel, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="在浏览器中打开搜索页" Padding="12,4"
                                Command="{Binding OpenSiteSearchCommand}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="提示:驱动天空(drvsky)只接受 POST 检索,程序会在本机生成一个表单页并交由浏览器提交;程序自身不会向该站发起请求。"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="内置驱动库状态(离线可用的关键)"/>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding LibraryHeadline}" FontWeight="Bold"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding ManifestSource, StringFormat=清单来源:{0}}"/>
                    <TextBlock Text="{Binding Root, StringFormat=驱动库根目录:{0}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ManifestPath, StringFormat=清单文件:{0}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LibraryVersion, StringFormat=清单版本:{0}}"/>
                    <TextBlock Text="{Binding ArchitectureText, StringFormat=当前架构 / 系统:{0}}"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="Bold"
                               Text="{Binding UnavailableEntries, StringFormat=不可直接安装的条目数:{0}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    BorderBrush="#FFC02828"
                    BorderThickness="1"
                    Visibility="{Binding HasMissingPackages, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding MissingHeader}" FontWeight="Bold" Foreground="#FFC02828" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding MissingPackages}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="在线补齐(L2 · 仅白名单官方源)"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding OnlineHint}" TextWrapping="Wrap" Foreground="#FF666666"/>

                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="品牌:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding Brands}" SelectedItem="{Binding OnlineBrand}" Margin="0,0,10,0"/>
                        <TextBlock Text="型号关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="200" Padding="4,3" Margin="0,0,10,0"
                                 Text="{Binding OnlineKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="检索官方源" Padding="12,4" Command="{Binding SearchOnlineCommand}"/>
                        <Button Content="打开 Microsoft Update Catalog" Padding="12,4" Margin="8,0,0,0"
                                Command="{Binding OpenCatalogCommand}"/>
                    </WrapPanel>

                    <TextBlock Margin="0,8,0,0" Text="{Binding OnlineSummary}" TextWrapping="Wrap" FontWeight="Bold"/>

                    <ListBox Style="{StaticResource EmbeddedList}"
                             ItemsSource="{Binding OnlineCandidates}"
                             SelectedItem="{Binding SelectedOnlineCandidate}"
                             Margin="0,4,0,0"
                             Visibility="{Binding HasOnlineCandidates, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Width="430"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding SourceName}" Width="210"/>
                                    <TextBlock Text="{Binding Version}" Width="90"/>
                                    <TextBlock Text="{Binding Size}" Width="80"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="① 下载并校验" Padding="12,4" Margin="0,0,8,0"
                                Command="{Binding DownloadOnlineCommand}"/>
                        <Button Content="② 解包并验证驱动包" Padding="12,4" Margin="0,0,8,0"
                                Command="{Binding ExtractOnlineCommand}"/>
                        <Button Content="③ 加入本机驱动库" Padding="12,4"
                                Command="{Binding ImportOnlineCommand}"/>
                        <Button Content="选择本地驱动包…" Padding="12,4" Margin="14,0,0,0"
                                Command="{Binding PickLocalPackageCommand}"
                                ToolTip="用于接手你自己从浏览器下载的驱动包(.cab / .zip / .exe / .inf)"/>
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="如果你是从浏览器手动下载的驱动包,点「选择本地驱动包…」指定它,再走 ②③ 即可(程序会接手校验、解包与入库)。"/>

                    <ProgressBar Height="6" Margin="0,10,0,0" IsIndeterminate="True"
                                 Visibility="{Binding OnlineBusy, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasOnlineDriverNames, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="从 INF 解析出的驱动名(入库时必须与 INF 逐字一致):"/>
                        <ComboBox Width="460" HorizontalAlignment="Left" Margin="0,4,0,0"
                                  ItemsSource="{Binding OnlineDriverNames}"
                                  SelectedItem="{Binding SelectedOnlineDriverName}"/>
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" Text="{Binding OnlineStageText}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding OnlineResultText}" TextWrapping="Wrap"
                               Foreground="#FF1B7F3B"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="内置驱动许可(本机授权开关)"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding PolicyHint}" TextWrapping="Wrap" Foreground="#FF666666"/>
                    <TextBlock Margin="0,6,0,0" Text="{Binding PolicySummary, StringFormat=当前策略:{0}}" TextWrapping="Wrap" FontWeight="Bold"/>

                    <CheckBox Margin="0,8,0,0"
                              Content="允许全部品牌使用内置驱动(仅本机个人使用)"
                              IsChecked="{Binding AllowAllBuiltinDrivers}"/>

                    <TextBlock Margin="0,8,0,2" Text="按品牌单独设置(优先级高于上面的全局开关):"/>
                    <DataGrid Style="{StaticResource EmbeddedGrid}"
                              IsReadOnly="False"
                              ItemsSource="{Binding BrandPolicies}"
                              Visibility="{Binding HasBrandPolicies, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="清单情况" Binding="{Binding SummaryText}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="允许内置驱动" Width="130"
                                                    Binding="{Binding IsBuiltinAllowed, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="各品牌可用性统计"/>
            <DataGrid Style="{StaticResource EmbeddedGrid}" ItemsSource="{Binding BrandSummaries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="180"/>
                    <DataGridTextColumn Header="条目统计" Binding="{Binding SummaryText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="全部内置驱动条目(按品牌分组,可展开)"/>
            <TreeView Style="{StaticResource EmbeddedTree}" ItemsSource="{Binding BrandGroups}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Entries}">
                        <TextBlock Text="{Binding Header}" FontWeight="Bold" Margin="0,2"/>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding DriverName}" Width="300" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PdlText}" Width="100"/>
                                    <TextBlock Text="{Binding ArchText}" Width="110"/>
                                    <TextBlock Text="{Binding RedistributableText}" Width="80"/>
                                    <TextBlock Text="{Binding AvailableText}" Width="70"
                                               Foreground="{Binding IsAvailable, Converter={StaticResource BoolToBrush}}"/>
                                    <TextBlock Text="{Binding Reason}" Foreground="#FF666666" MaxWidth="420"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TextBlock Style="{StaticResource SectionHeader}" Text="人工选择驱动(自动匹配失败时使用)"/>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="品牌:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="150" ItemsSource="{Binding Brands}" SelectedItem="{Binding BrandFilter}" Margin="0,0,10,0"/>
                <TextBlock Text="型号关键词:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="200" Padding="4,3" Margin="0,0,10,0"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="检索候选驱动" Command="{Binding SearchCandidatesCommand}"/>
                <Button Content="刷新驱动库状态" Command="{Binding RefreshCommand}"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualSummary}"/>

            <ListBox Style="{StaticResource EmbeddedList}"
                     ItemsSource="{Binding ManualCandidates}"
                     SelectedItem="{Binding SelectedManualCandidate}"
                     MinHeight="60"
                     Margin="0,0,0,6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DriverName}" Width="300" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Brand}" Width="110"/>
                            <TextBlock Text="{Binding PdlText}" Width="100"/>
                            <TextBlock Text="{Binding SourceText}" Width="110"/>
                            <TextBlock Text="{Binding ConfidenceText, StringFormat=置信度 {0}}" Width="90"/>
                            <TextBlock Text="可用" Foreground="#FF1B7F3B"
                                       Visibility="{Binding Installable, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding BlockReason}" Foreground="#FFC02828"
                                       Visibility="{Binding Installable, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <WrapPanel Margin="0,0,0,6">
                <Button Content="设为连接时使用的驱动" Command="{Binding UseCandidateCommand}"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding ManualSelectionText}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
