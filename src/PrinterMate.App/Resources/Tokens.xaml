<!--
    设计令牌层(TASK-001 / TASK-002)
    ================================
    规则:
      1. 令牌按【语义】命名,禁止按外观命名(不出现 Blue1 / Color2);
      2. 全应用的 页面 / 样式 必须引用令牌,不得再出现硬编码 #RRGGBB;
      3. 本文件是唯一的颜色来源 —— 未来若加深色模式,只需替换本文件的 Color 定义。

    当前主题:浅色(与 Windows 11 Fluent 对齐)。本规格明确不做深色模式。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 一、颜色定义 ============ -->

    <!-- 表面与背景 -->
    <Color x:Key="Color.Window">#FFF3F3F3</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceSubtle">#FFFAFAFA</Color>
    <Color x:Key="Color.SurfaceSunken">#FFF7F7F7</Color>

    <!-- 文字 -->
    <Color x:Key="Color.TextPrimary">#FF1F2A37</Color>
    <Color x:Key="Color.TextSecondary">#FF5C6470</Color>
    <Color x:Key="Color.TextTertiary">#FF8A8A8A</Color>
    <Color x:Key="Color.TextDisabled">#FFA8A8A8</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFFFF</Color>

    <!-- 边框与分隔线 -->
    <Color x:Key="Color.Border">#FFE3E3E3</Color>
    <Color x:Key="Color.BorderStrong">#FFD0D7DE</Color>
    <Color x:Key="Color.Divider">#FFEEEEEE</Color>

    <!-- 强调色(主操作) -->
    <Color x:Key="Color.Accent">#FF0F6CBD</Color>
    <Color x:Key="Color.AccentHover">#FF115EA3</Color>
    <Color x:Key="Color.AccentPressed">#FF0C3B5E</Color>
    <Color x:Key="Color.AccentSubtle">#FFEFF6FC</Color>

    <!-- 语义状态色 -->
    <Color x:Key="Color.Success">#FF107C10</Color>
    <Color x:Key="Color.SuccessSurface">#FFDFF6DD</Color>
    <Color x:Key="Color.Warning">#FFB45309</Color>
    <Color x:Key="Color.WarningSurface">#FFFFF4CE</Color>
    <Color x:Key="Color.Danger">#FFC42B1C</Color>
    <Color x:Key="Color.DangerSurface">#FFFDE7E9</Color>
    <Color x:Key="Color.Info">#FF0F6CBD</Color>
    <Color x:Key="Color.InfoSurface">#FFEFF6FC</Color>

    <!-- 控件专用 -->
    <Color x:Key="Color.ControlBackground">#FFFFFFFF</Color>
    <Color x:Key="Color.ControlBackgroundHover">#FFF7F7F7</Color>
    <Color x:Key="Color.ControlBackgroundPressed">#FFF0F0F0</Color>
    <Color x:Key="Color.ControlBackgroundDisabled">#FFF5F5F5</Color>
    <Color x:Key="Color.ControlBorder">#FFD1D1D1</Color>
    <Color x:Key="Color.ControlBorderDisabled">#FFE5E5E5</Color>

    <!-- 表格 -->
    <Color x:Key="Color.GridHeader">#FFF7F7F7</Color>
    <Color x:Key="Color.GridRowHover">#FFF5F9FD</Color>
    <Color x:Key="Color.GridRowSelected">#FFEFF6FC</Color>
    <Color x:Key="Color.GridLine">#FFE8E8E8</Color>
    <Color x:Key="Color.GridAlternate">#FFFBFBFB</Color>

    <!-- 滚动条 -->
    <Color x:Key="Color.ScrollThumb">#FFC8C8C8</Color>
    <Color x:Key="Color.ScrollThumbHover">#FFA0A0A0</Color>
    <Color x:Key="Color.ScrollTrack">#00FFFFFF</Color>

    <!-- 顶部信息条(深色) -->
    <Color x:Key="Color.HeaderBar">#FF23303D</Color>
    <Color x:Key="Color.HeaderText">#FFE8EDF2</Color>
    <Color x:Key="Color.HeaderTextAccent">#FFFFD18A</Color>

    <!-- 导航 -->
    <Color x:Key="Color.NavBackground">#FFF7F7F7</Color>
    <Color x:Key="Color.NavItemHover">#FFEDEDED</Color>
    <Color x:Key="Color.NavItemSelected">#FFEFF6FC</Color>
    <Color x:Key="Color.NavGroupHeader">#FF8A8A8A</Color>

    <!-- 阴影(以半透明色表达,差值极小以贴合 Fluent 的克制风格) -->
    <Color x:Key="Color.Shadow">#14000000</Color>

    <!-- ============ 二、画刷(引用上面的颜色) ============ -->

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="{StaticResource Color.SurfaceSubtle}"/>
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}"/>

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{StaticResource Color.SuccessSurface}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{StaticResource Color.WarningSurface}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.InfoSurface" Color="{StaticResource Color.InfoSurface}"/>

    <SolidColorBrush x:Key="Brush.ControlBackground" Color="{StaticResource Color.ControlBackground}"/>
    <SolidColorBrush x:Key="Brush.ControlBackgroundHover" Color="{StaticResource Color.ControlBackgroundHover}"/>
    <SolidColorBrush x:Key="Brush.ControlBackgroundPressed" Color="{StaticResource Color.ControlBackgroundPressed}"/>
    <SolidColorBrush x:Key="Brush.ControlBackgroundDisabled" Color="{StaticResource Color.ControlBackgroundDisabled}"/>
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Brush.ControlBorderDisabled" Color="{StaticResource Color.ControlBorderDisabled}"/>

    <SolidColorBrush x:Key="Brush.GridHeader" Color="{StaticResource Color.GridHeader}"/>
    <SolidColorBrush x:Key="Brush.GridRowHover" Color="{StaticResource Color.GridRowHover}"/>
    <SolidColorBrush x:Key="Brush.GridRowSelected" Color="{StaticResource Color.GridRowSelected}"/>
    <SolidColorBrush x:Key="Brush.GridLine" Color="{StaticResource Color.GridLine}"/>
    <SolidColorBrush x:Key="Brush.GridAlternate" Color="{StaticResource Color.GridAlternate}"/>

    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="{StaticResource Color.ScrollTrack}"/>

    <SolidColorBrush x:Key="Brush.HeaderBar" Color="{StaticResource Color.HeaderBar}"/>
    <SolidColorBrush x:Key="Brush.HeaderText" Color="{StaticResource Color.HeaderText}"/>
    <SolidColorBrush x:Key="Brush.HeaderTextAccent" Color="{StaticResource Color.HeaderTextAccent}"/>

    <SolidColorBrush x:Key="Brush.NavBackground" Color="{StaticResource Color.NavBackground}"/>
    <SolidColorBrush x:Key="Brush.NavItemHover" Color="{StaticResource Color.NavItemHover}"/>
    <SolidColorBrush x:Key="Brush.NavItemSelected" Color="{StaticResource Color.NavItemSelected}"/>
    <SolidColorBrush x:Key="Brush.NavGroupHeader" Color="{StaticResource Color.NavGroupHeader}"/>

    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}"/>
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>

    <!-- ============ 三、字体与字号 ============ -->

    <FontFamily x:Key="Font.Family">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <sys:Double x:Key="Font.Size.Disabled">12</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12.5</sys:Double>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">16</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>
    <sys:Double x:Key="Font.Size.Mono">12.5</sys:Double>

    <!-- ============ 四、间距 ============ -->

    <sys:Double x:Key="Space.XXS">2</sys:Double>
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>

    <Thickness x:Key="Padding.Card">14</Thickness>
    <Thickness x:Key="Padding.Control">10,5</Thickness>
    <Thickness x:Key="Padding.GridCell">10,7</Thickness>
    <Thickness x:Key="Margin.CardBottom">0,0,0,12</Thickness>
    <Thickness x:Key="Margin.SectionTop">0,14,0,8</Thickness>

    <!-- ============ 五、圆角 ============ -->

    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
