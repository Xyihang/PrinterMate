<!--
    数据视图样式层(TASK-006)
    ========================
    设计取舍(重要,避免踩坑):
      1. 各页面里的 EmbeddedGrid / EmbeddedList / EmbeddedTree 是【带 Key 的显式样式】,
         显式样式不会继承隐式样式 —— 因此本文件**不去改它们**,而是通过
         DataGridColumnHeader / DataGridRow / DataGridCell 这些【独立元素类型】的隐式样式
         来现代化外观。这样性能红线(禁用内层滚动 + 关闭虚拟化)一行未动。
      2. **不替换 DataGridColumnHeader 的模板**:它的默认模板含列宽拖拽把手
         (PART_LeftHeaderGripper / PART_RightHeaderGripper),替换会导致列宽无法拖拽。
      3. **不做斑马纹**:AlternatingRowBackground 与行样式 Background 会互相覆盖,
         且需要在两条性能红线样式里加 AlternatingCount,收益不抵风险。规格中斑马纹为可选项。
      4. 不替换 DataGridRow 模板:默认模板的 Border 会响应 Background,
         悬停/选中态直接设 Background 即可,安全。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ================= DataGrid:容器 ================= -->

    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.GridLine}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Brush.GridLine}"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ================= DataGrid:表头 ================= -->
    <!-- 只设安全属性,不替换模板(保留列宽拖拽把手) -->

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.GridHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ================= DataGrid:行 ================= -->

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.GridRowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.GridRowSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= DataGrid:单元格 ================= -->
    <!-- 关键:选中时把单元格背景设为透明,否则会盖住行选中色,出现刺眼的系统蓝 -->

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= ListBox ================= -->

    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.GridRowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.GridRowSelected}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TreeView ================= -->
    <!-- 只设安全属性,不替换 TreeViewItem 模板(展开/折叠依赖其模板内部部件) -->

    <Style TargetType="TreeView">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Padding" Value="4,3"/>
    </Style>

</ResourceDictionary>
