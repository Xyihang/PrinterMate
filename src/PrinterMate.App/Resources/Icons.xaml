<!--
    矢量图标资源(TASK-003)
    ======================
    规则:
      1. 全部用内联矢量路径,【不引入任何图标库】(规格第六章明确不做);
      2. 每个图标在 24×24 视口内设计,`Path` 通过 `Stretch="Uniform"` 缩放;
      3. 图标缺失时回退为纯文字,不得导致导航项消失(由使用方负责 Text 始终存在)。

    用法:
      <Path Data="{StaticResource Icon.Print}" Fill="{StaticResource Brush.TextPrimary}"
            Width="18" Height="18" Stretch="Uniform"/>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 导航图标 ===== -->

    <!-- 新手必读:书本 -->
    <Geometry x:Key="Icon.Book">M2,3 L11,5.5 L11,22 L2,19.5 Z M13,5.5 L22,3 L22,19.5 L13,22 Z</Geometry>

    <!-- 设备发现与连接:USB 连接头 -->
    <Geometry x:Key="Icon.Usb">M10,2 L14,2 L14,6 L10,6 Z M11,6 L13,6 L13,14 L11,14 Z M7,14 L17,14 L17,21 L7,21 Z</Geometry>

    <!-- 打印与测试页:打印机 -->
    <Geometry x:Key="Icon.Print">M7,2 L17,2 L17,7 L7,7 Z M3,8 L21,8 L21,16 L3,16 Z M7,12 L17,12 L17,22 L7,22 Z</Geometry>

    <!-- 任务队列与状态:列表 -->
    <Geometry x:Key="Icon.Queue">M2,5 L5,5 L5,8 L2,8 Z M7,5 L22,5 L22,8 L7,8 Z M2,10.5 L5,10.5 L5,13.5 L2,13.5 Z M7,10.5 L22,10.5 L22,13.5 L7,13.5 Z M2,16 L5,16 L5,19 L2,19 Z M7,16 L22,16 L22,19 L7,19 Z</Geometry>

    <!-- 驱动管理:立体包箱 -->
    <Geometry x:Key="Icon.Driver">M12,2 L22,7 L22,17 L12,22 L2,17 L2,7 Z M12,2 L12,12 M12,12 L2,7 M12,12 L22,7</Geometry>

    <!-- 设置:调节滑块 -->
    <Geometry x:Key="Icon.Settings">M2,6 L22,6 L22,8.5 L2,8.5 Z M2,16 L22,16 L22,18.5 L2,18.5 Z M7,3.5 L11,3.5 L11,11 L7,11 Z M13,13.5 L17,13.5 L17,21 L13,21 Z</Geometry>

    <!-- ===== 状态图标 ===== -->

    <!-- 成功:对勾 -->
    <Geometry x:Key="Icon.Check">M4,11.5 L9,16.5 L19.5,4 L22,6.5 L9,21 L1.5,14 Z</Geometry>

    <!-- 警示:三角形 -->
    <Geometry x:Key="Icon.Warning">M12,2 L23,21 L1,21 Z</Geometry>

    <!-- 错误:叉 -->
    <Geometry x:Key="Icon.Error">M6,4 L8,2 L12,6 L16,2 L18,4 L14,8 L18,12 L16,14 L12,10 L8,14 L6,12 L10,8 Z</Geometry>

    <!-- 信息:圆点加竖线 -->
    <Geometry x:Key="Icon.Info">M10,2 L14,2 L14,6 L10,6 Z M10,8.5 L14,8.5 L14,22 L10,22 Z</Geometry>

    <!-- ===== 操作图标 ===== -->

    <!-- 扫描/检索:放大镜 -->
    <Geometry x:Key="Icon.Search">M9,2 L14,2 L18,6 L18,11 L14,15 L9,15 L5,11 L5,6 Z M14,15 L16.5,12.5 L22,18 L19.5,20.5 Z</Geometry>

    <!-- 下载:向下箭头加底托 -->
    <Geometry x:Key="Icon.Download">M10,2 L14,2 L14,11 L18,11 L12,18 L6,11 L10,11 Z M3,20 L21,20 L21,23 L3,23 Z</Geometry>

    <!-- 文件夹 -->
    <Geometry x:Key="Icon.Folder">M2,4 L9,4 L11,7 L22,7 L22,20 L2,20 Z</Geometry>

    <!-- 外部链接 / 打开浏览器 -->
    <Geometry x:Key="Icon.OpenExternal">M13,2 L22,2 L22,11 L19.5,11 L19.5,6.5 L11,15 L9,13 L17.5,4.5 L13,4.5 Z M4,4 L11,4 L11,6.5 L6.5,6.5 L6.5,19.5 L17.5,19.5 L17.5,15 L20,15 L20,22 L4,22 Z</Geometry>

    <!-- 折叠箭头(收起 / 展开由使用方旋转) -->
    <Geometry x:Key="Icon.Chevron">M9,5 L18,12 L9,19 L6.5,16.5 L13,12 L6.5,7.5 Z</Geometry>

</ResourceDictionary>
